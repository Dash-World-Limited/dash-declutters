# /etc/dash/declutters-api.env  —  TEMPLATE. Contains no real values.
#
# systemd EnvironmentFile syntax: plain KEY=value.
#   - no `export`
#   - NO QUOTES. systemd treats quotes as part of the value, so a quoted secret
#     arrives with the quotes still in it and the boot guard rejects it for a
#     reason that looks nothing like the cause.
#
# Permissions:
#   sudo install -d -m 750 -o dash -g dash /etc/dash
#   sudo chown root:dash /etc/dash/declutters-api.env
#   sudo chmod 640 /etc/dash/declutters-api.env
#
# The authoritative variable contract is
# docs/RUNBOOK-DECLUTTERS-PRODUCTION.md in dashworldng-bit/DASH-APP. This file
# is a shape reminder, not a substitute for it.

# --- profile -----------------------------------------------------------------
# Defaults to `full`. A deployment that forgets this gets DASH APP's complete
# set of production guards and refuses to boot.
DEPLOYMENT_PROFILE=declutters
NODE_ENV=production

# --- core --------------------------------------------------------------------
DATABASE_URL=postgresql://USER:PASSWORD@RDS-ENDPOINT:5432/DATABASE
API_PORT=4000
PUBLIC_WEB_URL=https://declutters.dashworldng.com

# --- secrets — generate on the server, never in a chat window ----------------
#   openssl rand -base64 32
# JWT_REFRESH_SECRET must differ from JWT_ACCESS_SECRET; boot refuses if equal.
JWT_ACCESS_SECRET=GENERATE-32-RANDOM-BYTES
JWT_REFRESH_SECRET=GENERATE-32-DIFFERENT-RANDOM-BYTES
ENCRYPTION_KEY=GENERATE-32-RANDOM-BYTES-BASE64

# --- redis, on the same instance ---------------------------------------------
REDIS_URL=redis://127.0.0.1:6379
RATE_LIMIT_ENABLED=true
# Production refuses per-process counters: they multiply the real limit by the
# instance count.
RATE_LIMIT_REDIS=true
QUEUE_PROVIDER=redis

# --- geo ---------------------------------------------------------------------
# Required even here. Declutters asks no geography question, but the guard is
# DASH APP's and PostGIS must be installed for boot to pass.
GEO_ZONES_PROVIDER=postgis

# --- storage -----------------------------------------------------------------
# Production refuses `local`: disk storage is lost on redeploy and would take
# every listing photograph with it.
STORAGE_PROVIDER=s3
S3_BUCKET=VERIFY-THE-ACTUAL-BUCKET-NAME
S3_REGION=eu-west-1

# --- email -------------------------------------------------------------------
# Production refuses `console`. An unknown provider is a startup failure.
EMAIL_PROVIDER=ses
SES_REGION=eu-west-1
EMAIL_FROM_ADDRESS=no-reply@notify.dashworldng.com
EMAIL_FROM_NAME=DASH World
EMAIL_REPLY_TO=admin@dashworldng.com
SES_CONFIGURATION_SET=dash-declutters-ses-events
SES_EVENT_TOPIC_ARN=arn:aws:sns:eu-west-1:ACCOUNT-ID:dash-email-events

# --- valuation ---------------------------------------------------------------
# The only value. No live provider is connected, which is why no listing may be
# publicly labelled "DASH ValueChecked".
VALUECHECK_PROVIDER=local

# --- the sandbox gate --------------------------------------------------------
# Comma-separated addresses verified in the SES console. CLEAR THIS ONLY after
# SES production access is granted. While the account is sandboxed an empty
# allowlist means signup accepts anybody, creates their account, and sends a
# code SES silently drops — leaving a real person locked out of an account they
# cannot open, with no way to find out why.
SIGNUP_ALLOWLIST=verified@example.test

# --- credentials -------------------------------------------------------------
# Prefer an instance role and set nothing. Note that S3_ACCESS_KEY_ID and
# S3_SECRET_ACCESS_KEY are never read; they are classified only so an audit
# notices them.
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
