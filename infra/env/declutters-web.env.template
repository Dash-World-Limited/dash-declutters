# /etc/dash/declutters-web.env  —  TEMPLATE. Contains no real values.
#
# READ THIS FIRST: the three NEXT_PUBLIC_* variables below are inlined by
# `next build`. Setting them here does NOT change a running build. Changing any
# of them requires a rebuild with the values exported into the build's
# environment. They are listed here only so both halves of the deployment are
# described in the same place.
#
# DEPLOYMENT_PROFILE is the exception: the compiled middleware reads it at
# process start, so it genuinely belongs here.

DEPLOYMENT_PROFILE=declutters
NODE_ENV=production

# --- build-time only — a rebuild is required to change these -----------------
NEXT_PUBLIC_API_URL=https://api.dashworldng.com
NEXT_PUBLIC_SITE_ORIGIN=https://declutters.dashworldng.com

# Off unless deliberately switched on. While false, robots.txt is `Disallow: /`,
# the sitemap is empty and every page carries noindex. Turn it on only when
# there is real inventory: an empty marketplace indexed on day one is the
# version a search engine keeps.
NEXT_PUBLIC_DECLUTTER_INDEXABLE=false
